<?xml version="1.0" encoding="utf-8"?>
<!-- Diagonal / bottom-right scrim for the final CTA page.
     Uses a simple dark-to-transparent linear gradient at 315°
     so text on the right stays readable over the bright beach photo. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#99000000"
        android:endColor="#00000000" />
</shape>
