<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:id="@+id/top_bar_pass"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="24dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_back_pass"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_back"
            app:tint="#1D1D1D"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/top_bar_pass"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Change Password"
                android:textColor="#1D1D1D"
                android:textSize="24sp"
                android:fontFamily="@font/jost_bold"
                android:layout_marginBottom="32dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Current Password" android:fontFamily="@font/inconsolata" android:textColor="#1D1D1D" android:textSize="14sp" android:layout_marginBottom="8dp" />
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="#F4F5F7" app:cardCornerRadius="8dp" app:cardElevation="0dp" android:layout_marginBottom="20dp">
                <EditText
                    android:id="@+id/et_pass_current"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="Enter current password"
                    android:textColorHint="#9E9E9E"
                    android:padding="16dp"
                    android:inputType="textPassword"
                    android:textColor="#1D1D1D"
                    android:textSize="14sp" />
            </androidx.cardview.widget.CardView>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="New Password" android:fontFamily="@font/inconsolata" android:textColor="#1D1D1D" android:textSize="14sp" android:layout_marginBottom="8dp" />
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="#F4F5F7" app:cardCornerRadius="8dp" app:cardElevation="0dp" android:layout_marginBottom="20dp">
                <EditText
                    android:id="@+id/et_pass_new"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="Enter new password"
                    android:textColorHint="#9E9E9E"
                    android:padding="16dp"
                    android:inputType="textPassword"
                    android:textColor="#1D1D1D"
                    android:textSize="14sp" />
            </androidx.cardview.widget.CardView>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Confirm New Password" android:fontFamily="@font/inconsolata" android:textColor="#1D1D1D" android:textSize="14sp" android:layout_marginBottom="8dp" />
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="#F4F5F7" app:cardCornerRadius="8dp" app:cardElevation="0dp" android:layout_marginBottom="12dp">
                <EditText
                    android:id="@+id/et_pass_confirm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="Re-enter new password"
                    android:textColorHint="#9E9E9E"
                    android:padding="16dp"
                    android:inputType="textPassword"
                    android:textColor="#1D1D1D"
                    android:textSize="14sp" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tv_error_password_match"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Passwords do not match."
                android:textColor="#F44336"
                android:textSize="12sp"
                android:layout_marginBottom="24dp"
                android:visibility="gone" />

            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

            <androidx.cardview.widget.CardView
                android:id="@+id/btn_save_password"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@color/teal_primary"
                app:cardElevation="0dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:enabled="false"
                android:alpha="0.5">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Update Password"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:fontFamily="@font/jost_bold" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>