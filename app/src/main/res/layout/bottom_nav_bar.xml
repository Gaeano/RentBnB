<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomNavContainer"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <View
        android:id="@+id/navBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bottom_nav_bg"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:elevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <FrameLayout
            android:id="@+id/btnNavHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">
            
            <ImageView
                android:id="@+id/navHome"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_home"
                android:scaleType="center"
                android:contentDescription="@string/nav_home"
                app:tint="@color/white" />

            <View
                android:id="@+id/dotHome"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="10dp"
                android:background="@drawable/nav_dot_indicator"
                android:visibility="visible" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnNavFavorites"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/navFavorites"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_favorites"
                android:scaleType="center"
                android:contentDescription="@string/nav_favorites"
                android:alpha="0.7"
                app:tint="@color/white" />

            <View
                android:id="@+id/dotFavorites"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="10dp"
                android:background="@drawable/nav_dot_indicator"
                android:visibility="gone" />
        </FrameLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.8"
            android:visibility="invisible" />

        <FrameLayout
            android:id="@+id/btnNavBookings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/navBookings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_chat"
                android:scaleType="center"
                android:contentDescription="@string/nav_bookings"
                android:alpha="0.7"
                app:tint="@color/white" />

            <View
                android:id="@+id/dotBookings"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="10dp"
                android:background="@drawable/nav_dot_indicator"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnNavProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/navProfile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_profile"
                android:scaleType="center"
                android:contentDescription="@string/nav_profile"
                android:alpha="0.7"
                app:tint="@color/white" />

            <View
                android:id="@+id/dotProfile"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="10dp"
                android:background="@drawable/nav_dot_indicator"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/navFab"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:elevation="8dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/fab_inner_bg"
            android:src="@drawable/ic_lease"
            android:scaleType="centerInside"
            android:padding="10dp"
            app:tint="@color/teal_primary" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
