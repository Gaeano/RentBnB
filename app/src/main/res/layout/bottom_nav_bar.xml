<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomNavContainer"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- The actual bar background -->
    <View
        android:id="@+id/navBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bottom_nav_bg"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Navigation Items -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:elevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_home"
            android:scaleType="center"
            android:contentDescription="@string/nav_home"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white" />

        <ImageView
            android:id="@+id/navFavorites"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_favorites"
            android:scaleType="center"
            android:contentDescription="@string/nav_favorites"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:alpha="0.7"
            app:tint="@color/white" />

        <!-- Spacer for FAB centered in the bar -->
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.8"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/navBookings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_history"
            android:scaleType="center"
            android:contentDescription="@string/nav_bookings"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:alpha="0.7"
            app:tint="@color/white" />

        <ImageView
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_profile"
            android:scaleType="center"
            android:contentDescription="@string/nav_profile"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:alpha="0.7"
            app:tint="@color/white" />
    </LinearLayout>

    <!-- Floating Action Button - Now centered inside the bar -->
    <FrameLayout
        android:id="@+id/navFab"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:elevation="8dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Inner circle in #FAFAFA -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/fab_inner_bg"
            android:src="@drawable/ic_lease"
            android:scaleType="centerInside"
            android:padding="10dp"
            app:tint="@color/teal_primary" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
