<?xml version="1.0" encoding="utf-8"?>

<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/white"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@color/black" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:id="@+id/btnClearAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                android:text="Clear all"
                android:textColor="@color/teal_primary"
                android:textSize="14sp"
                android:fontFamily="@font/inconsolata"
                android:paddingEnd="8dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Filter"
                android:textColor="@color/black"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="@font/jost_bold" />

            <ImageButton
                android:id="@+id/btnCloseFilter"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                android:contentDescription="Close filter" />
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F0F0F0" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="10dp"
                    android:text="Category"
                    android:textColor="#1A1A1A"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/jost_bold"
                    android:letterSpacing="0.04" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:scrollbars="none"
                    android:clipToPadding="false">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true"
                        app:selectionRequired="false">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCatBoat"
                            style="@style/FilterChip"
                            android:text="Boat" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCatKayak"
                            style="@style/FilterChip"
                            android:text="Kayak / Paddle Board" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCatSnorkel"
                            style="@style/FilterChip"
                            android:text="Snorkel Set" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCatScuba"
                            style="@style/FilterChip"
                            android:text="Scuba Gear" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCatBicycle"
                            style="@style/FilterChip"
                            android:text="Bicycle" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCatMotorcycle"
                            style="@style/FilterChip"
                            android:text="Motorcycle" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCatSurfboard"
                            style="@style/FilterChip"
                            android:text="Surfboard" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCatCamera"
                            style="@style/FilterChip"
                            android:text="Camera" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCatCamping"
                            style="@style/FilterChip"
                            android:text="Camping Gear" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCatAtv"
                            style="@style/FilterChip"
                            android:text="ATV / Quad Bike" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCatJetSki"
                            style="@style/FilterChip"
                            android:text="Jet Ski" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCatOther"
                            style="@style/FilterChip"
                            android:text="Other" />

                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:background="#F0F0F0" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="12dp"
                        android:text="Price"
                        android:textColor="#1A1A1A"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/jost_bold"
                        android:letterSpacing="0.04" />

                    <com.google.android.material.slider.RangeSlider
                        android:id="@+id/priceRangeSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="0"
                        android:valueTo="10000"
                        android:stepSize="100"
                        app:thumbColor="@color/teal_primary"
                        app:trackColorActive="@color/teal_primary"
                        app:trackColorInactive="#E0E0E0"
                        app:thumbRadius="10dp"
                        app:trackHeight="3dp"
                        app:labelBehavior="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical">

                        <androidx.cardview.widget.CardView
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#F5F5F5">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingStart="10dp"
                                android:paddingEnd="6dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="₱"
                                    android:textColor="#888"
                                    android:textSize="13sp" />

                                <TextView
                                    android:id="@+id/tvPriceMin"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:paddingStart="4dp"
                                    android:text="0"
                                    android:textColor="#1A1A1A"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/inconsolata" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="–"
                            android:textColor="#888"
                            android:textSize="16sp" />

                        <androidx.cardview.widget.CardView
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#F5F5F5">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingStart="10dp"
                                android:paddingEnd="6dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="₱"
                                    android:textColor="#888"
                                    android:textSize="13sp" />

                                <TextView
                                    android:id="@+id/tvPriceMax"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:paddingStart="4dp"
                                    android:text="10,000"
                                    android:textColor="#1A1A1A"
                                    android:textSize="13sp"
                                    android:fontFamily="@font/inconsolata" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:background="#F0F0F0" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="10dp"
                        android:text="Price Unit"
                        android:textColor="#1A1A1A"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/jost_bold"
                        android:letterSpacing="0.04" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupPriceUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="false">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipUnitDay"
                            style="@style/FilterChip"
                            android:text="/day" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipUnitHour"
                            style="@style/FilterChip"
                            android:text="/hour" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipUnitWeek"
                            style="@style/FilterChip"
                            android:text="/week" />

                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:background="#F0F0F0" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="10dp"
                        android:text="Sort By"
                        android:textColor="#1A1A1A"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/jost_bold"
                        android:letterSpacing="0.04" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupSortBy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="false">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipSortMostRented"
                            style="@style/FilterChip"
                            android:text="Most Rented" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipSortNewest"
                            style="@style/FilterChip"
                            android:text="Newest" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipSortPriceLow"
                            style="@style/FilterChip"
                            android:text="Price: Low → High" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipSortPriceHigh"
                            style="@style/FilterChip"
                            android:text="Price: High → Low" />

                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F0F0F0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="28dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApplyFilters"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Apply Filters"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/jost_bold"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/teal_primary"
                app:cornerRadius="26dp"
                app:elevation="0dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>