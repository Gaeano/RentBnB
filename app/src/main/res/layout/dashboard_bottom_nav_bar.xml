<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomNavContainer"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <View
        android:id="@+id/navBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bottom_nav_bg"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:elevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <FrameLayout
            android:id="@+id/btnNavDashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/navDashboard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_dashboard"
                android:scaleType="center"
                android:contentDescription="Dashboard"
                app:tint="@color/white" />

            <View
                android:id="@+id/dotDashboard"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="10dp"
                android:background="@drawable/nav_dot_indicator"
                android:visibility="visible" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnNavCalendar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/navCalendar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_calendar"
                android:scaleType="center"
                android:contentDescription="Calendar"
                android:alpha="0.7"
                app:tint="@color/white" />

            <View
                android:id="@+id/dotCalendar"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="10dp"
                android:background="@drawable/nav_dot_indicator"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnNavListings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/navListings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_listing"
                android:scaleType="center"
                android:contentDescription="Calendar"
                android:alpha="0.7"
                app:tint="@color/white" />

            <View
                android:id="@+id/dotListings"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="10dp"
                android:background="@drawable/nav_dot_indicator"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnNavInbox"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center">

                <ImageView
                    android:id="@+id/navInbox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_chat"
                    android:alpha="0.7"
                    app:tint="@color/white" />

            </RelativeLayout>

            <View
                android:id="@+id/dotInbox"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="10dp"
                android:background="@drawable/nav_dot_indicator"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnNavProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/navProfile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_profile"
                android:scaleType="center"
                android:contentDescription="Profile"
                android:alpha="0.7"
                app:tint="@color/white" />

            <View
                android:id="@+id/dotProfile"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="10dp"
                android:background="@drawable/nav_dot_indicator"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>