<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_chat.xml
    Chat inbox screen with two tabs (As Renter / As Owner).

    Structure:
      ┌─────────────────────────────────┐
      │  "Inbox" header                 │  ← tvInboxHeader (status bar aware)
      │  [As Renter] [As Owner]         │  ← TabLayout
      │─────────────────────────────────│
      │  RecyclerView (chat room list)  │
      │  OR empty state text            │
      └─────────────────────────────────┘
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- ── Header ─────────────────────────────────────────────────────────── -->
    <TextView
        android:id="@+id/tvInboxHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Inbox"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:paddingHorizontal="20dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Tab Layout ─────────────────────────────────────────────────────── -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutChats"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabSelectedTextColor="@color/teal_primary"
        app:tabTextColor="@color/text_grey"
        app:tabIndicatorColor="@color/teal_primary"
        app:tabIndicatorHeight="3dp"
        app:layout_constraintTop_toBottomOf="@id/tvInboxHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Divider ─────────────────────────────────────────────────────────── -->
    <View
        android:id="@+id/dividerChats"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        app:layout_constraintTop_toBottomOf="@id/tabLayoutChats"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Chat Room List ─────────────────────────────────────────────────── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewChats"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/dividerChats"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Empty State ────────────────────────────────────────────────────── -->
    <TextView
        android:id="@+id/tvEmptyChats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No conversations yet.\nStart by tapping 'Chat' on a listing."
        android:textAlignment="center"
        android:textColor="@color/text_grey"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/dividerChats"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>