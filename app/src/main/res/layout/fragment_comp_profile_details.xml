<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <com.faltenreich.skeletonlayout.SkeletonLayout
        android:id="@+id/skeleton_comp_profile_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:maskColor="#E0E0E0"
        app:shimmerColor="#F5F5F5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:animateLayoutChanges="true">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Company Details" android:textColor="#1D1D1D" android:textSize="24sp" android:fontFamily="@font/jost_bold" android:layout_marginBottom="24dp"/>

            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Account Name" android:fontFamily="@font/jost_semibold" android:textColor="#9E9E9E" android:textSize="14sp" android:layout_alignParentStart="true"/>
                <TextView android:id="@+id/tv_detail_comp_name" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="Boat Rentals Inc." android:fontFamily="@font/jost_bold" android:textColor="#1D1D1D" android:textSize="14sp" android:layout_alignParentEnd="true"/>
            </RelativeLayout>

            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Business Type" android:fontFamily="@font/jost_semibold" android:textColor="#9E9E9E" android:textSize="14sp" android:layout_alignParentStart="true"/>
                <TextView android:id="@+id/tv_detail_comp_type" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="Boat Rentals" android:fontFamily="@font/jost_bold" android:textColor="#1D1D1D" android:textSize="14sp" android:layout_alignParentEnd="true"/>
            </RelativeLayout>

            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Years of Operation" android:fontFamily="@font/jost_semibold" android:textColor="#9E9E9E" android:textSize="14sp" android:layout_alignParentStart="true"/>
                <TextView android:id="@+id/tv_detail_comp_years" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="2 Years" android:fontFamily="@font/jost_bold" android:textColor="#1D1D1D" android:textSize="14sp" android:layout_alignParentEnd="true"/>
            </RelativeLayout>

            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Email Address" android:fontFamily="@font/jost_semibold" android:textColor="#9E9E9E" android:textSize="14sp" android:layout_alignParentStart="true"/>
                <TextView android:id="@+id/tv_detail_comp_email" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="contact@boatrentals.com" android:fontFamily="@font/jost_bold" android:textColor="#1D1D1D" android:textSize="14sp" android:layout_alignParentEnd="true"/>
            </RelativeLayout>

            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Phone Number" android:fontFamily="@font/jost_semibold" android:textColor="#9E9E9E" android:textSize="14sp" android:layout_alignParentStart="true"/>
                <TextView android:id="@+id/tv_detail_comp_phone" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="(+63) 912 345 6789" android:fontFamily="@font/jost_bold" android:textColor="#1D1D1D" android:textSize="14sp" android:layout_alignParentEnd="true"/>
            </RelativeLayout>

            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Full Address" android:fontFamily="@font/jost_semibold" android:textColor="#9E9E9E" android:textSize="14sp" android:layout_alignParentStart="true"/>
                <TextView android:id="@+id/tv_detail_comp_address" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="N.s Cabanhud, Lapu-Lapu" android:fontFamily="@font/jost_bold" android:textColor="#1D1D1D" android:textSize="14sp" android:layout_alignParentEnd="true" android:maxWidth="200dp" android:gravity="end"/>
            </RelativeLayout>

            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="City" android:fontFamily="@font/jost_semibold" android:textColor="#9E9E9E" android:textSize="14sp" android:layout_alignParentStart="true"/>
                <TextView android:id="@+id/tv_detail_comp_city" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="Lap-Lap City" android:fontFamily="@font/jost_bold" android:textColor="#1D1D1D" android:textSize="14sp" android:layout_alignParentEnd="true" android:maxWidth="200dp" android:gravity="end"/>
            </RelativeLayout>

            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="32dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Province" android:fontFamily="@font/jost_semibold" android:textColor="#9E9E9E" android:textSize="14sp" android:layout_alignParentStart="true"/>
                <TextView android:id="@+id/tv_detail_comp_province" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="Ang Probinsyano" android:fontFamily="@font/jost_bold" android:textColor="#1D1D1D" android:textSize="14sp" android:layout_alignParentEnd="true" android:maxWidth="200dp" android:gravity="end"/>
            </RelativeLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_marginBottom="32dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Service Area" android:textColor="#1D1D1D" android:textSize="24sp" android:fontFamily="@font/jost_bold" android:layout_marginBottom="24dp"/>

            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Radius" android:fontFamily="@font/jost_semibold" android:textColor="#9E9E9E" android:textSize="14sp" android:layout_alignParentStart="true"/>
                <TextView android:id="@+id/tv_detail_radius" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="45 km" android:fontFamily="@font/jost_bold" android:textColor="#1D1D1D" android:textSize="14sp" android:layout_alignParentEnd="true"/>
            </RelativeLayout>

            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Coverage" android:fontFamily="@font/jost_semibold" android:textColor="#9E9E9E" android:textSize="14sp" android:layout_alignParentStart="true"/>
                <TextView android:id="@+id/tv_detail_coverage" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="Within City" android:fontFamily="@font/jost_bold" android:textColor="#1D1D1D" android:textSize="14sp" android:layout_alignParentEnd="true"/>
            </RelativeLayout>

            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="32dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Specific Areas" android:fontFamily="@font/jost_semibold" android:textColor="#9E9E9E" android:textSize="14sp" android:layout_alignParentStart="true"/>
                <TextView android:id="@+id/tv_detail_specific_areas" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="Lakawon Islands, Sipalay" android:fontFamily="@font/jost_bold" android:textColor="#1D1D1D" android:textSize="14sp" android:layout_alignParentEnd="true" android:maxWidth="200dp" android:gravity="end"/>
            </RelativeLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/btn_edit_profile_toggle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                app:cardBackgroundColor="@color/teal_primary"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@android:drawable/ic_menu_edit" app:tint="@color/white" android:layout_marginEnd="8dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Edit" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </com.faltenreich.skeletonlayout.SkeletonLayout>
</ScrollView>