<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Company Details"
            android:textColor="#1D1D1D"
            android:textSize="24sp"
            android:fontFamily="@font/jost_bold"
            android:layout_marginBottom="24dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Account Name" android:fontFamily="@font/inconsolata" android:textColor="#1D1D1D" android:textSize="14sp" android:layout_marginBottom="8dp" />
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="#F4F5F7" app:cardCornerRadius="8dp" app:cardElevation="0dp" android:layout_marginBottom="16dp">
            <EditText android:id="@+id/et_edit_comp_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@null" android:padding="16dp" android:textColor="#1D1D1D" android:textSize="14sp" />
        </androidx.cardview.widget.CardView>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="16dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Business Type" android:fontFamily="@font/inconsolata" android:textColor="#1D1D1D" android:textSize="14sp" android:layout_marginBottom="8dp" />
                <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="#F4F5F7" app:cardCornerRadius="8dp" app:cardElevation="0dp">
                    <EditText android:id="@+id/et_edit_comp_type" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@null" android:padding="16dp" android:textColor="#1D1D1D" android:textSize="14sp" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Years of Operation" android:fontFamily="@font/inconsolata" android:textColor="#1D1D1D" android:textSize="14sp" android:layout_marginBottom="8dp" />
                <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="#F4F5F7" app:cardCornerRadius="8dp" app:cardElevation="0dp">
                    <EditText android:id="@+id/et_edit_comp_years" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@null" android:padding="16dp" android:inputType="number" android:textColor="#1D1D1D" android:textSize="14sp" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Email Address" android:fontFamily="@font/inconsolata" android:textColor="#1D1D1D" android:textSize="14sp" android:layout_marginBottom="8dp" />
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="#EBEBEB" app:cardCornerRadius="8dp" app:cardElevation="0dp" android:layout_marginBottom="16dp">
            <EditText android:id="@+id/et_edit_comp_email" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@null" android:padding="16dp" android:enabled="false" android:textColor="#757575" android:textSize="14sp" />
        </androidx.cardview.widget.CardView>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Phone number" android:fontFamily="@font/inconsolata" android:textColor="#1D1D1D" android:textSize="14sp" android:layout_marginBottom="8dp" />
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="#F4F5F7" app:cardCornerRadius="8dp" app:cardElevation="0dp" android:layout_marginBottom="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🇵🇭 +63" android:textColor="#1D1D1D" android:textSize="14sp" android:paddingStart="16dp" android:paddingEnd="12dp" />
                <View android:layout_width="1dp" android:layout_height="24dp" android:background="#D0D0D0" />
                <EditText android:id="@+id/et_edit_comp_phone" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@null" android:padding="16dp" android:inputType="phone" android:maxLength="10" android:textColor="#1D1D1D" android:textSize="14sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Full Address" android:fontFamily="@font/inconsolata" android:textColor="#1D1D1D" android:textSize="14sp" android:layout_marginBottom="8dp" />
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="#F4F5F7" app:cardCornerRadius="8dp" app:cardElevation="0dp" android:layout_marginBottom="16dp">
            <EditText android:id="@+id/et_edit_comp_address" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@null" android:padding="16dp" android:textColor="#1D1D1D" android:textSize="14sp" />
        </androidx.cardview.widget.CardView>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="32dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="City" android:fontFamily="@font/inconsolata" android:textColor="#1D1D1D" android:textSize="14sp" android:layout_marginBottom="8dp" />
                <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="#F4F5F7" app:cardCornerRadius="8dp" app:cardElevation="0dp">
                    <EditText android:id="@+id/et_edit_comp_city" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@null" android:padding="16dp" android:textColor="#1D1D1D" android:textSize="14sp" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Province" android:fontFamily="@font/inconsolata" android:textColor="#1D1D1D" android:textSize="14sp" android:layout_marginBottom="8dp" />
                <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="#F4F5F7" app:cardCornerRadius="8dp" app:cardElevation="0dp">
                    <EditText android:id="@+id/et_edit_comp_province" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@null" android:padding="16dp" android:textColor="#1D1D1D" android:textSize="14sp" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Service Area" android:textColor="#1D1D1D" android:textSize="18sp" android:fontFamily="@font/jost_bold" android:layout_marginBottom="16dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="16dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Radius" android:fontFamily="@font/inconsolata" android:textColor="#1D1D1D" android:textSize="14sp" android:layout_marginBottom="8dp" />
                <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="#F4F5F7" app:cardCornerRadius="8dp" app:cardElevation="0dp">
                    <EditText android:id="@+id/et_edit_comp_radius" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@null" android:padding="16dp" android:textColor="#1D1D1D" android:textSize="14sp" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Coverage" android:fontFamily="@font/inconsolata" android:textColor="#1D1D1D" android:textSize="14sp" android:layout_marginBottom="8dp" />
                <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="#F4F5F7" app:cardCornerRadius="8dp" app:cardElevation="0dp">
                    <EditText android:id="@+id/et_edit_comp_coverage" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@null" android:padding="16dp" android:textColor="#1D1D1D" android:textSize="14sp" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Specific Areas" android:fontFamily="@font/inconsolata" android:textColor="#1D1D1D" android:textSize="14sp" android:layout_marginBottom="8dp" />
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="#F4F5F7" app:cardCornerRadius="8dp" app:cardElevation="0dp" android:layout_marginBottom="32dp">
            <EditText android:id="@+id/et_edit_comp_specific_areas" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@null" android:padding="16dp" android:textColor="#1D1D1D" android:textSize="14sp" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/btn_save_comp_profile"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/teal_primary"
            app:cardElevation="0dp"
            android:layout_marginBottom="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="Save Update" android:textColor="@android:color/white" android:textSize="16sp" android:fontFamily="@font/jost_bold" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/btn_comp_change_password"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_btn_outline"
            android:gravity="center"
            android:text="Change Password"
            android:textColor="@color/teal_primary"
            android:textSize="16sp"
            android:fontFamily="@font/jost_bold" />

    </LinearLayout>
</ScrollView>