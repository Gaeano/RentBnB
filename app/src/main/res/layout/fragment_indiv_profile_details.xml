<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <com.faltenreich.skeletonlayout.SkeletonLayout
        android:id="@+id/skeleton_profile_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:maskColor="#E0E0E0"
        app:shimmerColor="#F5F5F5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:animateLayoutChanges="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile Details"
                android:textColor="@color/black"
                android:textSize="24sp"
                android:fontFamily="@font/jost_bold"
                android:layout_marginBottom="24dp"/>

            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Full Name"
                    android:fontFamily="@font/jost_semibold"
                    android:textColor="#9E9E9E"
                    android:textSize="14sp"
                    android:layout_alignParentStart="true"/>
                <TextView
                    android:id="@+id/tv_detail_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="John Cena"
                    android:fontFamily="@font/jost_bold"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>

            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Age"
                    android:fontFamily="@font/jost_semibold"
                    android:textColor="#9E9E9E"
                    android:textSize="14sp"
                    android:layout_alignParentStart="true"/>
                <TextView
                    android:id="@+id/tv_detail_age"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="20"
                    android:fontFamily="@font/jost_bold"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>

            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gender"
                    android:fontFamily="@font/jost_semibold"
                    android:textColor="#9E9E9E"
                    android:textSize="14sp"
                    android:layout_alignParentStart="true"/>
                <TextView
                    android:id="@+id/tv_detail_gender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Male"
                    android:fontFamily="@font/jost_bold"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>

            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email Address"
                    android:fontFamily="@font/jost_semibold"
                    android:textColor="#9E9E9E"
                    android:textSize="14sp"
                    android:layout_alignParentStart="true"/>
                <TextView
                    android:id="@+id/tv_detail_email"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="lenamuller@sample.com"
                    android:fontFamily="@font/jost_bold"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>

            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phone Number"
                    android:fontFamily="@font/jost_semibold"
                    android:textColor="#9E9E9E"
                    android:textSize="14sp"
                    android:layout_alignParentStart="true"/>
                <TextView
                    android:id="@+id/tv_detail_phone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="(+63) 912 345 6789"
                    android:fontFamily="@font/jost_bold"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>

            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home Address"
                    android:fontFamily="@font/jost_semibold"
                    android:textColor="#9E9E9E"
                    android:textSize="14sp"
                    android:layout_alignParentStart="true"/>
                <TextView
                    android:id="@+id/tv_detail_address"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="123 Villa Yer, Minglanilla, Cebu"
                    android:fontFamily="@font/jost_bold"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:layout_alignParentEnd="true"
                    android:maxWidth="200dp"
                    android:gravity="end"/>
            </RelativeLayout>

            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="City"
                    android:fontFamily="@font/jost_semibold"
                    android:textColor="#9E9E9E"
                    android:textSize="14sp"
                    android:layout_alignParentStart="true"/>
                <TextView
                    android:id="@+id/tv_detail_city"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Cebu City"
                    android:fontFamily="@font/jost_bold"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:layout_alignParentEnd="true"
                    android:maxWidth="200dp"
                    android:gravity="end"/>
            </RelativeLayout>

            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="32dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Province"
                    android:fontFamily="@font/jost_semibold"
                    android:textColor="#9E9E9E"
                    android:textSize="14sp"
                    android:layout_alignParentStart="true"/>
                <TextView
                    android:id="@+id/tv_detail_province"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Minglanilla, Cebu"
                    android:fontFamily="@font/jost_bold"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:layout_alignParentEnd="true"
                    android:maxWidth="200dp"
                    android:gravity="end"/>
            </RelativeLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/btn_edit_profile_toggle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                app:cardBackgroundColor="@color/teal_primary"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@android:drawable/ic_menu_edit"
                        app:tint="@color/white"
                        android:layout_marginEnd="8dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Edit"
                        android:fontFamily="@font/jost_bold"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </com.faltenreich.skeletonlayout.SkeletonLayout>
</ScrollView>