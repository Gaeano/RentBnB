<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Set Penalty Fee"
                android:textSize="20sp"
                android:textColor="@color/black"
                android:fontFamily="@font/jost_bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Specify the amount to be charged if the product is not returned on time."
                android:textSize="13sp"
                android:textColor="@color/text_grey"
                android:fontFamily="@font/inconsolata"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginBottom="28dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Penalty Unit"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:fontFamily="@font/jost_semibold"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:background="@drawable/toggle_group_bg"
                android:padding="4dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/btnHourlyPenalty"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Hourly"
                    android:textSize="13sp"
                    android:fontFamily="@font/jost_bold"
                    android:background="@drawable/unit_btn_selected_bg"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnDailyPenalty"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:gravity="center"
                    android:text="Daily"
                    android:textSize="13sp"
                    android:fontFamily="@font/jost"
                    android:background="@drawable/unit_btn_bg"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnWeeklyPenalty"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Weekly"
                    android:textSize="13sp"
                    android:fontFamily="@font/jost"
                    android:background="@drawable/unit_btn_bg"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnMonthlyPenalty"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Monthly"
                    android:textSize="13sp"
                    android:fontFamily="@font/jost"
                    android:background="@drawable/unit_btn_bg"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Penalty Amount"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:fontFamily="@font/jost_semibold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:orientation="horizontal"
                android:background="@drawable/input_bg"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₱"
                    android:textSize="18sp"
                    android:textColor="@color/black"
                    android:fontFamily="@font/jost"
                    android:paddingStart="16dp"
                    android:paddingEnd="4dp" />

                <EditText
                    android:id="@+id/etPenaltyPrice"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="0.00"
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/hint_color"
                    android:fontFamily="@font/jost"
                    android:background="@android:color/transparent"
                    android:paddingEnd="16dp"
                    android:inputType="numberDecimal"
                    android:maxLines="1" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This is the fee charged per unit of delay."
                android:textSize="12sp"
                android:textColor="@color/text_grey"
                android:fontFamily="@font/inconsolata"
                android:layout_marginBottom="28dp" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp"
        android:background="@color/white">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnContinuePenalty"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Continue"
            android:textColor="@color/white"
            android:fontFamily="@font/jost_bold"
            android:textAllCaps="false"
            android:background="@drawable/btn_primary_bg" />
    </LinearLayout>

</LinearLayout>