<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/emptyStateListings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="40dp"
    android:visibility="gone">

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ic_listing"
        android:alpha="0.4"
        app:tint="#BDBDBD" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No listings yet"
        android:textColor="#1D1D1D"
        android:textSize="26sp"
        android:fontFamily="@font/jost_bold"
        android:layout_marginTop="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Start earning by adding your first property"
        android:textColor="#666666"
        android:fontFamily="@font/inconsolata"
        android:textSize="14sp"
        android:textAlignment="center"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEmptyStateAddListing"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:text="Add New Listing"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:fontFamily="@font/jost_semibold"
        android:paddingHorizontal="32dp"
        app:cornerRadius="28dp"
        app:backgroundTint="@color/teal_primary"
        app:icon="@drawable/ic_lease"
        app:iconTint="@color/white"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        android:elevation="2dp" />

</LinearLayout>