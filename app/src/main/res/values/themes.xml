<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/teal_primary</item>

        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_wrapper</item>

        <item name="postSplashScreenTheme">@style/Theme.RentBnb</item>
    </style>

    <!-- Base application theme. -->
    <style name="Theme.RentBnb" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary color: #FAFAFA (white) -->
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryVariant">@color/white</item>
        <item name="colorOnPrimary">@color/black</item>

        <!-- Secondary color: Teal -->
        <item name="colorSecondary">@color/teal_primary</item>
        <item name="colorSecondaryVariant">@color/teal_dark</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Accent/Tertiary color: Black -->
        <item name="colorAccent">@color/teal_primary</item>
        <item name="colorError">#B00020</item>

        <!-- Window attributes -->
        <item name="android:windowBackground">@color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>

        <item name="android:textAllCaps">false</item>

        <item name="alertDialogTheme">@style/Theme.RentBnb.AlertDialog</item>
    </style>

    <style name="Theme.RentBnb.AlertDialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">@color/teal_dark</item>
        <item name="colorOnSurface">@color/text_dark</item>
    </style>

    <style name="FilterChip" parent="Widget.MaterialComponents.Chip.Filter">
        <!-- Shape -->
        <item name="chipCornerRadius">20dp</item>
        <item name="chipMinHeight">34dp</item>

        <!-- Spacing -->
        <item name="chipStartPadding">12dp</item>
        <item name="chipEndPadding">12dp</item>

        <!-- Text -->
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/inconsolata</item>

        <!-- Default -->
        <item name="chipBackgroundColor">@color/white</item>
        <item name="chipStrokeColor">@color/black</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/black</item>

        <!-- No checkmark icon -->
        <item name="checkedIconVisible">false</item>
        <item name="chipIconVisible">false</item>
    </style>

    <style name="CustomMaterialCalendar" parent="ThemeOverlay.MaterialComponents.MaterialCalendar">
        <item name="buttonBarPositiveButtonStyle">@style/CustomCalendarButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/CustomCalendarButton</item>
    </style>

    <style name="CustomCalendarButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/black</item>
    </style>
    <style name="ShapeAppearanceOverlay.App.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="CustomDatePickerTheme" parent="ThemeOverlay.MaterialComponents.MaterialCalendar">
        <item name="colorPrimary">@color/teal_primary</item>
        <item name="colorOnPrimary">@android:color/white</item>
    </style>

    <style name="CustomTimePickerTheme" parent="ThemeOverlay.MaterialComponents.TimePicker">
        <item name="colorPrimary">@color/teal_primary</item>
        <item name="colorOnPrimary">@android:color/white</item>
    </style>
    <style name="CustomAlertDialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">@color/indicator_active</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>
</resources>


